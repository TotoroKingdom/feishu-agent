# 飞书项目周报 Agent 配置模板
#
# 使用方式：复制为本地未提交的 .env 文件，填入真实值后再运行检查命令。
# 本文件只保留示例值和注释，禁止写入真实 Secret、PAT 或 API Key。
# 当前仓库尚无运行时加载器；T5 之前不要把本文件当作生产配置系统。

# -----------------------------------------------------------------------------
# 运行剖面与 Provider 选择
# 来源：docs/02-architecture-design.md §6.4；docs/06-implementation-plan.md T5。
# local-demo 使用 Fake Adapter，不需要真实飞书/GitHub/LLM 凭证。
# -----------------------------------------------------------------------------
APP_PROFILE=local-demo
FEISHU_PROVIDER=fake
GITHUB_PROVIDER=fake
LLM_PROVIDER=fake
LOG_LEVEL=INFO

# 服务监听参数。
# 来源：docs/01-feishu-project-weekly-agent-prd.md 的 FastAPI/Next.js 部署要求；
# 真实回调验证还需要公网 HTTPS 地址，local-demo 不需要。
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
FEISHU_CALLBACK_URL=

# -----------------------------------------------------------------------------
# PostgreSQL / Redis
# 来源：docs/02-architecture-design.md §1、§5.2；docs/03-database-design.md §1、§11。
# PostgreSQL 是事实源；Redis 只用于缓存、锁、限流和运行控制，不能单独保存业务事实。
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://neondb_owner:npg_UaiL5nhDGvF7@ep-floral-base-a1i5ojao-pooler.ap-southeast-1.aws.neon.tech/knowledge_rag_agent?sslmode=require
REDIS_URL=redis://127.0.0.1:6379/0

# 凭证加密和内部调用保护。
# 来源：docs/01-feishu-project-weekly-agent-prd.md §7.1；docs/04-api-design.md §5.4。
# 生产环境必须由 Secret Manager 注入；不要把真实值写入 .env.example 或 Git。
CREDENTIAL_ENCRYPTION_KEY=replace-with-secret-manager-value
INTERNAL_SERVICE_TOKEN=replace-with-secret-manager-value

# -----------------------------------------------------------------------------
# 飞书企业自建应用
# 来源：docs/02-architecture-design.md §5.2、§5.3；
# scripts/spikes/feishu_spike.py 的 REQUIRED_ENV。
# 获取位置：飞书开放平台应用详情、事件订阅配置和测试资源。
# -----------------------------------------------------------------------------
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=cli_aae84a7f76789bd4
FEISHU_APP_SECRET=NwV9p5cslNmroxeEDEEL6g8GQLIlW8Jm
FEISHU_VERIFICATION_TOKEN=feishu123
FEISHU_ENCRYPT_KEY=G9dQgtOApwAhs00pE3JRDgcTtyteOhoP

# 以下是 T2 真实 sandbox 资源，不是应用凭证。
# 需要飞书管理员提供：测试用户、测试群、测试多维表格和文档目录/父文档。
FEISHU_TEST_USER_OPEN_ID=ou_replace_me
FEISHU_TEST_CHAT_ID=oc_replace_me
FEISHU_TEST_BITABLE_APP_TOKEN=app_replace_me
FEISHU_TEST_BITABLE_TABLE_ID=tbl_replace_me
FEISHU_TEST_DOCUMENT_PARENT_TOKEN=doc_replace_me

# API 中 user_id_type 的默认选择；实际值需以 T2 真实能力验证为准。
# 来源：docs/04-api-design.md §3；docs/02-architecture-design.md F-04/F-08。
FEISHU_USER_ID_TYPE=open_id

# -----------------------------------------------------------------------------
# GitHub 只读采集
# 来源：docs/02-architecture-design.md §5.4；
# scripts/spikes/github_spike.py 的 REQUIRED_ENV；docs/06-implementation-plan.md T3。
# 获取位置：GitHub Fine-grained PAT 设置页和仓库管理员提供的两个测试仓库。
# PAT 只允许按 T3 结果授予最小只读权限，禁止写入 Issue/PR/代码。
# -----------------------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_PAT=github_pat_replace_me
GITHUB_TEST_REPO_1=owner/test-repository-one
GITHUB_TEST_REPO_2=owner/test-repository-two

# 采集口径和边界。
# 来源：docs/02-architecture-design.md G-03/G-05/G-08/G-09；MVP 最多五仓。
GITHUB_MAX_REPOSITORIES=5
GITHUB_DEFAULT_BRANCH_SCOPE=default_branch
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# OpenAI 兼容 LLM（默认设计为 DeepSeek）
# 来源：docs/02-architecture-design.md §5.2、§5.5；
# scripts/spikes/llm_spike.py 的 REQUIRED_ENV；docs/04-api-design.md §5.6。
# 获取位置：Provider 控制台的 Base URL、API Key 和模型名称。
# T3 未完成真实验证前建议保持 LLM_PROVIDER=fake；不要求 Streaming。
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_STREAM=false

# -----------------------------------------------------------------------------
# 项目报告口径
# 来源：docs/01-feishu-project-weekly-agent-prd.md §3、§5；
# docs/02-architecture-design.md A-04/A-05。
# 具体指标口径、时区和周区间仍需人工确认，不要在这里默认为已冻结协议。
# -----------------------------------------------------------------------------
PROJECT_TIMEZONE=Asia/Shanghai
REPORT_PERIOD_DAYS=7
REPORT_PERIOD_START=
REPORT_PERIOD_END=

# -----------------------------------------------------------------------------
# 运行和安全限制
# 来源：docs/01-feishu-project-weekly-agent-prd.md §4、§7；
# docs/02-architecture-design.md §3、§6.4；docs/05-langgraph-design.md §3。
# -----------------------------------------------------------------------------
MAX_GITHUB_REPOSITORIES=5
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
EXTERNAL_MAX_RETRIES=3
MAX_CALLBACK_BODY_BYTES=1048576
MAX_LLM_INPUT_CHARS=50000
MAX_SOURCE_RECORDS_PER_BATCH=10000
